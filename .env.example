# ============================================================
# Copy this file to ".env" and fill in your own credentials.
# The real .env file is listed in .gitignore so it is NEVER
# uploaded to GitHub.
# ============================================================

# --- Discord -------------------------------------------------
# Discord -> Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=

# --- Telegram ------------------------------------------------
# 1. Message @BotFather on Telegram -> /newbot -> copy the token
# 2. Add the bot to your channel/group, then get the chat id (e.g. from @userinfobot)
#    Use @yourchannel for public channels (gives a public post link)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dev.to --------------------------------------------------
# dev.to -> Settings -> Extensions -> DEV Community API Keys -> Generate
DEVTO_API_KEY=

# --- Mastodon ------------------------------------------------
# Your instance -> Preferences -> Development -> New Application -> copy the Access Token
MASTODON_API_BASE=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Hashnode ------------------------------------------------
# 1. https://hashnode.com/settings/developer -> Generate New Token (Personal Access Token)
# 2. Publication id: run the "me { publications }" query from the README
HASHNODE_PAT=
HASHNODE_PUBLICATION_ID=

# --- Pastebin ------------------------------------------------
# https://pastebin.com/doc_api -> "Generate your API key"
PASTEBIN_API_KEY=
